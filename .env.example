# =============================================================================
# Stealth Couple Chat App - Environment Configuration
# =============================================================================

# Zero-config default: The app works out of the box locally and on Vercel
# without needing any database or third-party services.
# 
# OPTIONAL: Supabase Cloud Database (if you want infinite persistent storage)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# SUPABASE_ANON_KEY=your-anon-key-here

# OPTIONAL: Default Secret Room Key (can also be configured inside the app)
# NEXT_PUBLIC_ROOM_SECRET=our-secret-lounge
